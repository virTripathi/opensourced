{
  "name": "worksmarter",
  "private": true,
  "version": "0.1.0",
  "description": "Worksmarter - Open-Source Onboarding Assistant (Chrome Side Panel + NestJS Orchestrator)",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
