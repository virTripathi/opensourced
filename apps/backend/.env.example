# Worksmarter Backend Environment Configuration

# Server Port
PORT=3001

# Google Gemini API Key (Required for Strategy Pattern model reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub OAuth / Personal Access Token (Optional for unauthenticated local development)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Google OAuth (For Google Drive export - drive.file scope)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
