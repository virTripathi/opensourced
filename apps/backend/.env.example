# ==============================================================================
# OpenSourced — Backend Environment Variables Configuration
# Copy this file to .env and provide your secrets/credentials.
# ==============================================================================

# Server Network Configuration
PORT=8000

# Security & Session Encryption (32-byte hex string for AES-256-GCM token encryption)
ENCRYPTION_KEY=e8dcaf543c68cce597118563d33bd91a561f172b2feb74bf6be3c7efdb943751
JWT_SECRET=opensourced-default-secret-hackathon-2026

# ==============================================================================
# GitHub App Configuration (User-to-Server Flow)
# Register a GitHub App under: GitHub -> Settings -> Developer Settings -> GitHub Apps
# - Homepage URL: http://localhost:8000
# - Callback URL: http://localhost:8000/api/auth/github/callback
# - Webhook: Inactive (Unchecked)
# - Expire user authorization tokens: Checked (Opt-in)
# - Permissions: Contents (Read), Issues (Read), Metadata (Read), Pull Requests (Read & Write)
# ==============================================================================
GITHUB_APP_NAME=opensourced-official
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

# GitHub Personal Access Token (Optional fallback for rate limit relief in guest mode)
GITHUB_TOKEN=

# ==============================================================================
# Google Cloud OAuth 2.0 Credentials (Google Drive Export - drive.file scope)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# - Application Type: Web application
# - Authorised JavaScript origins: http://localhost:8000
# - Authorised redirect URIs: http://localhost:8000/api/auth/google/callback
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
DEFAULT_STORAGE_PROVIDER=google_drive

# ==============================================================================
# AI Reasoning Engine (Google Gemini)
# Get your API key at: https://aistudio.google.com/
# ==============================================================================
RANKING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Database & Storage Strategy Configuration (SQLite / Memory / PostgreSQL)
# ==============================================================================
DATABASE_TYPE=sqlite
DATABASE_URL="file:./data/opensourced.db"
