        "tags": [
          "Authentication & Session"
        ]
      }
    },
    "/api/auth/pat": {
      "post": {
        "operationId": "AuthController_savePat",
        "summary": "Configure GitHub Personal Access Token (PAT)",
        "description": "Stores a GitHub PAT strictly bound to the authenticated user ID for GitHub API rate limit relief. The token is never shared with or accessible to other users.",
