        },
        "tags": [
          "Authentication & Session"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      },
      "get": {
        "operationId": "AuthController_getPatStatus",
        "summary": "Check User PAT Status",
        "description": "Returns whether the user has a configured PAT and a masked preview. Never exposes the full raw PAT.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "PAT status preview"
          }
        },
        "tags": [
          "Authentication & Session"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
    "/api/auth/github": {
      "get": {
        "operationId": "AuthController_githubLogin",
        "summary": "Initiate GitHub App User-to-Server Authorization",
        "description": "Redirects user to GitHub App authorization endpoint. Relies on fine-grained permissions configured on the GitHub App without requiring broad OAuth repository scopes.",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Authentication & Session"
        ]
      }
    },
    "/api/auth/github/callback": {
      "get": {
        "operationId": "AuthController_githubCallback",
        "summary": "GitHub App OAuth Callback",
        "description": "Handles redirect from GitHub, captures short-lived access token and refresh token, issues JWT, sets HTTP-only cookie, and redirects to client.",
        "parameters": [
          {
            "name": "redirect",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Authentication & Session"
        ]
      }
    },
    "/api/auth/github/refresh": {
      "post": {
        "operationId": "AuthController_refreshGitHubToken",
        "summary": "Rotate GitHub App User Access Token",
        "description": "Uses the stored refresh token to issue a new short-lived user access token and a rotated refresh token.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Token refreshed successfully"
          }
        },
        "tags": [
          "Authentication & Session"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
