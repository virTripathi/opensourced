{
  "openapi": "3.0.0",
  "paths": {
    "/api/git/picker": {
      "post": {
        "operationId": "GitController_openFolderPicker",
        "summary": "Open Native OS Folder Picker",
        "description": "Triggers a native desktop directory chooser dialog (osascript on macOS, zenity on Linux, powershell on Windows) for selecting a clone target path.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenFolderPickerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected directory path or cancellation flag"
          }
        },
        "tags": [
          "Local Git & Workspace Engine"
        ]
      }
    },
    "/api/git/clone": {
      "post": {
        "operationId": "GitController_cloneStream",
        "summary": "Clone Repository Locally with Progress Stream",
        "description": "Executes git clone into the selected local target directory and streams real-time stdout/stderr percentage events via Server-Sent Events.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloneRepositoryRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming git clone progress events"
          }
        },
        "tags": [
          "Local Git & Workspace Engine"
        ]
      }
    },
    "/api/git/cancel": {
      "post": {
        "operationId": "GitController_cancelClone",
        "summary": "Stop Ongoing Git Clone and Clean Up Files",
        "description": "Terminates active git clone child process and deletes any partially downloaded files from disk to prevent orphaned files.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Confirmation that clone was cancelled and files cleaned up"
          }
        },
        "tags": [
          "Local Git & Workspace Engine"
        ]
      }
    },
    "/api/agent/stream": {
      "post": {
        "operationId": "AgentController_streamAction",
        "summary": "Execute Agentic Action Loop",
        "description": "Universal execution endpoint that runs multi-turn tool calling and streams events (SSE)",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "Repository & Feature Intelligence"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
    "/api/agent/summarise": {
      "post": {
        "operationId": "AgentController_summariseRepo",
        "summary": "Summarise Entire Repository",
        "description": "Performs universal multi-language architecture analysis, identifies entrypoints, detects credential leaks in tree, produces Mermaid diagrams, and outputs deterministic local setup guides.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummariseRepoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured repository intelligence summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepoSummaryResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Repository & Feature Intelligence"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
    "/api/agent/summarise-feature": {
      "post": {
        "operationId": "AgentController_summariseFeature",
        "summary": "Summarise Specific Feature in Repository",
        "description": "Pinpoints exact entrypoints, line ranges, symbol definitions, sequence dataflow diagrams, and local test verification for a specific feature. (Omits general purpose and audience).",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummariseFeatureDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured feature implementation summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureSummaryResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Repository & Feature Intelligence"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "AuthController_getSession",
