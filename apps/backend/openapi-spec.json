    "/api/reports": {
      "post": {
        "operationId": "ReportsController_createReport",
        "summary": "Save Generated Analysis / Research Report",
        "description": "Persists a research artifact (issue analysis, entrypoints, OWASP check, PR draft) strictly bound to the authenticated user ID. Prevents IDOR across users.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReportDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report successfully saved and associated with user"
          }
        },
        "tags": [
          "User Reports & Research History"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      },
      "get": {
        "operationId": "ReportsController_listReports",
        "summary": "List Authenticated User Reports",
        "description": "Retrieves all analysis and research reports owned exclusively by the authenticated user. Never exposes reports belonging to other users.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of reports owned by current user"
          }
        },
        "tags": [
          "User Reports & Research History"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
    "/api/reports/{id}": {
      "get": {
        "operationId": "ReportsController_getReport",
        "summary": "Get Specific Report by ID (IDOR Protected)",
        "description": "Fetches a single report by ID. STRICT AUTHORIZATION: Enforces that the requesting user owns the report. If another user attempts to access this report, returns 404 to avoid enumeration and IDOR data leaks.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Report ID (e.g. rep_abc123)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report details"
          },
          "404": {
            "description": "Report not found or not owned by user"
          }
        },
        "tags": [
          "User Reports & Research History"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      },
      "delete": {
        "operationId": "ReportsController_deleteReport",
        "summary": "Delete Report by ID (IDOR Protected)",
        "description": "Deletes a report by ID. Strictly verifies that the requesting user is the owner before deleting. Cross-user deletion attempts are blocked.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Report ID to delete",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report successfully deleted"
          },
          "404": {
            "description": "Report not found or not owned by user"
          }
        },
        "tags": [
          "User Reports & Research History"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    },
    "/api/drive/export": {
      "post": {
        "operationId": "DriveController_exportDocument",
        "summary": "Export Research & Architecture Notes to Google Drive",
        "description": "Compiles the session research report and saves it directly to Google Drive under drive.file scope, bound to the authenticated user.",
        "parameters": [],
        "requestBody": {
          "required": true,
