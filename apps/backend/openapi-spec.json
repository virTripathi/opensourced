    "/api/auth/dev-login": {
      "post": {
        "operationId": "AuthController_devLogin",
        "summary": "Developer / Multi-User Test Login",
        "description": "Allows switching between test user identities (e.g., alice, bob) to verify multi-tenant isolation, authorization policies, and IDOR prevention.",
        "parameters": [],
        "requestBody": {
          "required": true,
