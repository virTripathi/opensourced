          "Google Drive Export"
        ],
        "security": [
          {
            "JWT-auth": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "OpenSourced API - Open-Source Onboarding Assistant",
    "description": "Complete OpenAPI specification for OpenSourced backend intelligence engine. Includes repository & feature summarisation, universal multi-language architecture analysis, credential leak guardrails, Git workspace bridging, and Google Drive artifact export. Import directly into Postman via http://localhost:8001/api/docs-json or using the exported openapi-spec.json.",
    "version": "1.2.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Repository & Feature Intelligence",
      "description": "High-velocity repository architecture summarisation, entrypoint discovery, and feature tracing"
    },
    {
      "name": "Local Git & Workspace Engine",
      "description": "Native desktop directory picker bridge and streaming git clone"
    },
    {
      "name": "Google Drive Export",
      "description": "Exports session research artifacts directly into Google Drive (drive.file scope)"
    },
    {
      "name": "Authentication & Session",
      "description": "GitHub and Google OAuth2 user session and token verification"
    },
    {
      "name": "User Reports & Research History",
      "description": "Persistent user research reports and analysis history with strict multi-tenant IDOR protections"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8001",
      "description": "Active Local Server"
    },
    {
      "url": "http://localhost:8000",
      "description": "Default Port (8000)"
    }
  ],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Provide JWT token generated via /api/auth/dev-login, /api/auth/guest, or OAuth"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth_token",
        "description": "HTTP-only session cookie set automatically on authentication"
      }
    },
    "schemas": {
      "OpenFolderPickerDto": {
        "type": "object",
        "properties": {
          "repoName": {
            "type": "string",
            "description": "Repository name used to propose default destination directory",
            "example": "react"
          }
        },
        "required": [
          "repoName"
        ]
      },
      "CloneRepositoryRequestDto": {
        "type": "object",
        "properties": {
          "repoUrl": {
            "type": "string",
            "description": "Canonical git clone URL",
            "example": "https://github.com/facebook/react.git"
          },
          "owner": {
            "type": "string",
            "description": "Repository owner",
            "example": "facebook"
          },
          "repo": {
            "type": "string",
            "description": "Repository name",
            "example": "react"
          },
          "destinationPath": {
            "type": "string",
            "description": "Target filesystem directory path chosen via native folder picker",
            "example": "~/Projects/react"
          },
          "autoOpenVsCode": {
            "type": "boolean",
            "description": "Whether to open VS Code upon successful cloning",
            "example": true,
            "default": true
          }
        },
        "required": [
          "repoUrl",
          "owner",
          "repo"
        ]
      },
      "SummariseRepoDto": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner or organization name (e.g., facebook, calcom, vercel)",
            "example": "facebook"
          },
          "repo": {
            "type": "string",
            "description": "Repository name (e.g., react, cal.com, next.js)",
            "example": "react"
          },
          "branch": {
            "type": "string",
            "description": "Target git branch or commit reference (defaults to default_branch, usually main/master)",
            "example": "main"
          },
          "focusAreas": {
            "description": "Optional focus areas to prioritize in the architectural summary",
            "example": [
              "compiler",
              "concurrency",
              "reconciler"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "customPat": {
            "type": "string",
            "description": "Optional personal access token for higher GitHub rate limits or private repositories",
            "example": "ghp_exampleToken1234567890abcdef"
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      },
      "RepoMetadataDto": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "example": "facebook/react",
            "description": "Canonical repository identifier"
          },
          "primaryLanguage": {
            "type": "string",
            "example": "JavaScript",
            "description": "Primary language declared by GitHub"
          },
          "ecosystem": {
            "type": "string",
            "example": "typescript",
            "description": "Detected ecosystem identifier"
          },
          "techStack": {
            "example": [
              "React",
              "Next.js",
              "Turborepo"
            ],
            "description": "Detected frameworks and libraries",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "object",
            "example": "MIT License",
            "nullable": true,
            "description": "Software license name"
          },
          "isMonorepo": {
            "type": "boolean",
            "example": true,
            "description": "Whether the project is structured as a monorepo"
          },
          "commitSha": {
            "type": "string",
            "example": "16a1d5d780b9cbbe2e1ac5f3dc6db8df6e7983ec",
            "description": "Verified Git commit SHA"
          }
        },
        "required": [
          "repo",
          "primaryLanguage",
          "ecosystem",
          "techStack",
          "license",
          "isMonorepo"
        ]
      },
      "TargetAudienceDto": {
        "type": "object",
        "properties": {
          "primaryBeneficiaries": {
            "example": [
              "Frontend Engineers",
              "Full-stack Developers",
              "Open-source Contributors"
            ],
            "description": "Who gets benefitted and directly uses this project",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "useCases": {
            "example": [
              "Building reactive single-page client applications",
              "Developing cross-platform UI components",
              "Contributing to core compiler logic"
            ],
            "description": "Top practical scenarios where this project is used",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "primaryBeneficiaries",
          "useCases"
        ]
      },
      "CoreComponentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "react_compiler",
            "description": "Name of subsystem or package"
          },
          "path": {
            "type": "string",
            "example": "compiler/crates/react_compiler/src/lib.rs",
            "description": "Root file or directory path"
          },
          "role": {
            "type": "string",
            "example": "Transforms React components into optimized low-level instructions",
            "description": "Role in architecture"
          },
          "dependencies": {
            "example": [
              "rustc",
              "syn"
            ],
            "description": "Immediate package dependencies",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "path",
          "role",
          "dependencies"
        ]
      },
      "ArchitectureDto": {
        "type": "object",
        "properties": {
          "overview": {
            "type": "string",
            "example": "Modular monorepo architecture separating the core reconciler, DOM renderer, and compiler.",
            "description": "High-level architectural pattern"
          },
          "mermaidDiagram": {
            "type": "string",
            "example": "graph TB\n  Client[\"Client Tier (React DOM)\"] --> Reconciler[\"Fiber Reconciler\"]\n  Reconciler --> Compiler[\"React Compiler Engine\"]",
            "description": "Valid, sanitized Mermaid diagram code ready for rendering"
          },
          "coreComponents": {
            "description": "Key components and modules comprising the system",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoreComponentDto"
            }
          }
        },
        "required": [
          "overview",
          "mermaidDiagram",
          "coreComponents"
        ]
      },
      "EntryFileDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "packages/react/src/index.js",
            "description": "Relative file path from repository root"
          },
          "description": {
            "type": "string",
            "example": "Main package entrypoint exporting public Hooks and Component APIs",
            "description": "Why this file is critical"
          },
          "keyExportsOrSymbols": {
            "example": [
              "useState",
              "useEffect",
              "useMemo",
              "Component"
            ],
            "description": "Key exports or classes",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "description",
          "keyExportsOrSymbols"
        ]
      },
      "SecurityFindingDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "example": "Hardcoded Secret / Leaked Credential",
            "description": "Vulnerability category"
          },
          "severity": {
            "type": "string",
            "example": "CRITICAL",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFORMATIONAL"
            ]
          },
          "fileOrLocation": {
