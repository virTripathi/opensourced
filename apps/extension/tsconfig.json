{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@opensourced/common": ["../../packages/common/src/index.ts"],
      "@opensourced/common/types": ["../../packages/common/src/types/index.ts"]
    }
  },
  "include": ["src/**/*", "manifest.json", "vite.config.ts"]
}
